# ==============================================================================
# 100-Day FAANG DSA Preparation Platform - Backend Environment Configuration
# ==============================================================================

# Port the Express.js server will listen on
PORT=5001

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# MongoDB Connection String
# If MongoDB is unreachable, the system automatically falls back to integrated local JSON persistence (src/data/db.json).
MONGO_URI=mongodb://localhost:27017/dsa100

# Allowed Frontend Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Secret key for signing 256-bit JWT authentication session tokens
# In production, replace this with a secure random 32+ character string
JWT_SECRET=faang_100_antigravity_super_secret_jwt_key_2026
